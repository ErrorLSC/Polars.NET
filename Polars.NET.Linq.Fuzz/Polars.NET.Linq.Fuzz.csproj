<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8600;CS8604;CS8603</NoWarn>
    <RustLibPath>..\native_shim\target\debug</RustLibPath>
    <RustLibName>libnative_shim.so</RustLibName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(RustLibPath)\$(RustLibName)" Condition="Exists('$(RustLibPath)\$(RustLibName)')">
      <Link>$(RustLibName)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polars.CSharp\Polars.CSharp.csproj" />
  </ItemGroup>

</Project>
