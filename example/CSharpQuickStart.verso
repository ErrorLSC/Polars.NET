    {
      "id": "d68687f0-c7e7-4bd8-9b96-9ba397d8d016",
      "type": "code",
      "language": "csharp",
      "source": "var WindowDf = df.Select(Pl.Col(\"Date\"),Pl.Col(\"City\"),Pl.Col(\"Temperature\")\n                        ,Pl.Col(\"Temperature\").Mean().Over(Pl.Col(\"Date\")).Alias(\"Daily_Avg\")\n                        ,(Pl.Col(\"Temperature\") - Pl.Col(\"Temperature\").Mean().Over(Pl.Col(\"Date\"))).Alias(\"Diff\")\n        ).Sort(\"Date\",false);\n\nWindowDf",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "(1,16): error CS0103: 当前上下文中不存在名称“df”\n(1,26): error CS0103: 当前上下文中不存在名称“Pl”\n(1,41): error CS0103: 当前上下文中不存在名称“Pl”\n(1,56): error CS0103: 当前上下文中不存在名称“Pl”\n(2,26): error CS0103: 当前上下文中不存在名称“Pl”\n(2,60): error CS0103: 当前上下文中不存在名称“Pl”\n(3,27): error CS0103: 当前上下文中不存在名称“Pl”\n(3,51): error CS0103: 当前上下文中不存在名称“Pl”\n(3,85): error CS0103: 当前上下文中不存在名称“Pl”\n(1,1): error CS0670: 字段不能有 void 类型",
