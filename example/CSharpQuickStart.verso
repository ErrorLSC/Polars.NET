    {
      "id": "e8712336-bdc8-4906-ad8a-3dadd76b10d6",
      "type": "code",
      "language": "csharp",
      "source": "var df = DataFrame.FromColumns(new \n{\n    Date = new[] { \u00222023-01-01\u0022, \u00222023-01-01\u0022,\u00222023-01-02\u0022 }, // Index 0\n    City = new[] { \u0022London\u0022, \u0022Manchester\u0022,\u0022London\u0022 },    // Index 1\n    Temperature = new[] { 10.5, 9.0,12.1 },   // Index 2\n    Rain = new[] {true,true,false} // Index 3\n})\n.WithColumns(Pl.Col(\u0022Date\u0022).Str.ToDate(\u0022%Y-%m-%d\u0022));\n\ndf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cstyle\u003E.verso-obj-tree{--obj-bg:var(--vscode-editor-background,var(--verso-cell-output-background,#fff));--obj-fg:var(--vscode-editor-foreground,var(--verso-cell-output-foreground,#1e1e1e));--obj-border:var(--vscode-editorWidget-border,var(--verso-border-default,#e0e0e0));--obj-header-bg:var(--vscode-editorWidget-background,var(--verso-cell-background,#f5f5f5));--obj-hover:var(--vscode-list-hoverBackground,var(--verso-cell-hover-background,#f0f0f0));--obj-muted:var(--vscode-descriptionForeground,var(--verso-editor-line-number,#858585));--obj-accent:var(--vscode-textLink-foreground,var(--verso-accent-primary,#0078d4));--obj-summary-bg:var(--vscode-sideBar-background,var(--verso-cell-background,#f5f5f5));font-family:var(--verso-code-output-font-family,monospace);font-size:13px;color:var(--obj-fg);}.verso-obj-tree details.verso-obj-node{border:1px solid var(--obj-border);border-radius:3px;margin:2px 0;}.verso-obj-tree details.verso-obj-node\u003Esummary.verso-obj-summary{padding:3px 8px;cursor:pointer;list-style:none;background:var(--obj-summary-bg);display:flex;align-items:center;gap:4px;user-select:none;}.verso-obj-tree details.verso-obj-node\u003Esummary.verso-obj-summary::-webkit-details-marker{display:none;}.verso-obj-tree details.verso-obj-node\u003Esummary.verso-obj-summary::before{content:\u0027\\25B6\u0027;font-size:9px;color:var(--obj-muted);transition:transform 0.1s;}.verso-obj-tree details.verso-obj-node[open]\u003Esummary.verso-obj-summary::before{transform:rotate(90deg);}.verso-obj-tree summary.verso-obj-summary:hover{background:var(--obj-hover);}.verso-obj-tree .verso-obj-type{font-weight:600;color:var(--obj-accent);}.verso-obj-tree .verso-obj-count{color:var(--obj-muted);font-size:11px;}.verso-obj-tree table.verso-obj-table{border-collapse:collapse;width:100%;background:var(--obj-bg);color:var(--obj-fg);}.verso-obj-tree table.verso-obj-table th.verso-obj-th{text-align:left;padding:4px 10px;border-bottom:2px solid var(--obj-border);background:var(--obj-header-bg);font-weight:600;white-space:nowrap;}.verso-obj-tree table.verso-obj-table td.verso-obj-member{padding:3px 10px;border-bottom:1px solid var(--obj-border);color:var(--obj-muted);white-space:nowrap;vertical-align:top;font-size:12px;}.verso-obj-tree table.verso-obj-table td.verso-obj-value{padding:3px 10px;border-bottom:1px solid var(--obj-border);vertical-align:top;}.verso-obj-tree table.verso-obj-table tbody tr:hover{background:var(--obj-hover);}.verso-obj-tree .verso-obj-null{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-cycle{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-empty{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-footer{padding:4px 10px;color:var(--obj-muted);font-size:11px;border-top:1px solid var(--obj-border);}\u003C/style\u003E\u003Cdiv class=\u0022verso-obj-tree\u0022\u003E\u003Cdetails class=\u0022verso-obj-node\u0022 open\u003E\u003Csummary class=\u0022verso-obj-summary\u0022\u003E\u003Cspan class=\u0022verso-obj-type\u0022\u003EDataFrame\u003C/span\u003E\u003Cspan class=\u0022verso-obj-count\u0022\u003E (4 items)\u003C/span\u003E\u003C/summary\u003E\u003Ctable class=\u0022verso-obj-table\u0022\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EIsEmpty\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003ENChunks\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EIsContiguous\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EDt\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EStr\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EList\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EArray\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EStruct\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EBin\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003ECat\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EExt\u003C/th\u003E\u003Cth c