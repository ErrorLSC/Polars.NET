    {
      "id": "d68687f0-c7e7-4bd8-9b96-9ba397d8d016",
      "type": "code",
      "language": "csharp",
      "source": "var WindowDf = df.Select(Pl.Col(\"Date\"),Pl.Col(\"City\"),Pl.Col(\"Temperature\")\n                        ,Pl.Col(\"Temperature\").Mean().Over(Pl.Col(\"Date\")).Alias(\"Daily_Avg\")\n                        ,(Pl.Col(\"Temperature\") - Pl.Col(\"Temperature\").Mean().Over(Pl.Col(\"Date\"))).Alias(\"Diff\")\n        ).Sort(\"Date\",false);\n\nWindowDf",
