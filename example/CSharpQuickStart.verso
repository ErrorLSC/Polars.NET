    {
      "id": "28e1b962-8d51-4d8c-bf6e-e37b9dc8f7ce",
      "type": "code",
      "language": "csharp",
      "source": "var df = DataFrame.FromColumns(new \n{\n    Date = new[] { \"2023-01-01\", \"2023-01-01\",\"2023-01-02\" }, // Index 0\n    City = new[] { \"London\", \"Manchester\",\"London\" },    // Index 1\n    Temperature = new[] { 10.5, 9.0,12.1 },   // Index 2\n    Rain = new[] {true,true,false} // Index 3\n})\n.WithColumns(Pl.Col(\"Date\").Str.ToDate(\"%Y-%m-%d\"));\n\ndf",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "(1,10): error CS0103: 当前上下文中不存在名称“DataFrame”\n(8,14): error CS0103: 当前上下文中不存在名称“Pl”",
          "isError": true,
          "errorName": "CompilationError"
        }
      ],
