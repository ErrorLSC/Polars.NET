    {
      "id": "268a9594-eaa7-493e-ac66-e5bd99d2547a",
      "type": "code",
      "language": "csharp",
      "source": "#r \u0022nuget: Polars.NET, 0.6.0\u0022\n#r \u0022nuget: Polars.NET.Native.linux-x64, 0.6.0\u0022\n#r \u0022nuget: Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\u0022\n\nusing Microsoft.DotNet.Interactive.Formatting;\nusing Polars.CSharp;\nusing Pl = Polars.CSharp.Polars;\n\nFormatter.Register\u003CDataFrame\u003E((df,writer)=\u003E\n{\n    writer.Write(df.ToHtml());\n}, \u0022text/html\u0022);",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\u003Cb\u003EInstalled Packages\u003C/b\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EPolars.NET, 0.6.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EPolars.NET.Native.linux-x64, 0.6.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cdetails\u003E\u003Csummary\u003ETransitive dependencies (14)\u003C/summary\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EApache.Arrow, 23.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EApache.Arrow.Adbc, 0.23.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EApache.Arrow.Scalars, 23.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EFSharp.Core, 10.0.100\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.AspNetCore.Html.Abstractions, 2.3.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.Bcl.AsyncInterfaces, 10.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.CSharp, 4.7.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EPolars.NET.Core, 0.6.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Diagnostics.DiagnosticSource, 9.0.6\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.IO.Pipelines, 10.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Memory, 4.6.3\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Numerics.Tensors, 10.0.5\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Text.Encodings.Web, 8.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Text.Json, 10.0.0\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003C/details\u003E\u003C/div\u003E"
        }
      ]
    },
    {
      "id": "28e1b962-8d51-4d8c-bf6e-e37b9dc8f7ce",
      "type": "code",
      "language": "csharp",
      "source": "var df = DataFrame.FromColumns(new \n{\n    Date = new[] { \u00222023-01-01\u0022, \u00222023-01-01\u0022,\u00222023-01-02\u0022 }, // Index 0\n    City = new[] { \u0022London\u0022, \u0022Manchester\u0022,\u0022London\u0022 },    // Index 1\n    Temperature = new[] { 10.5, 9.0,12.1 },   // Index 2\n    Rain = new[] {true,true,false} // Index 3\n})\n.WithColumns(Pl.Col(\u0022Date\u0022).Str.ToDate(\u0022%Y-%m-%d\u0022));\n\ndf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n\u003Cstyle\u003E\n.pl-dataframe { font-family: \u0027Consolas\u0027, \u0027Monaco\u0027, monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n\u003C/style\u003E\u003Cdiv class=\u0027pl-dim\u0027\u003EPolars DataFrame: \u003Cb\u003E(3 rows, 4 columns)\u003C/b\u003E\u003C/div\u003E\u003Cdiv style=\u0027overflow-x:auto\u0027\u003E\u003Ctable class=\u0027pl-dataframe\u0027\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EDate\u003Cspan class=\u0027pl-dtype\u0027\u003Edate32\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ECity\u003Cspan class=\u0027pl-dtype\u0027\u003Eutf8view\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ETemperature\u003Cspan class=\u0027pl-dtype\u0027\u003Edouble\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ERain\u003Cspan class=\u0027pl-dtype\u0027\u003Ebool\u003C/span\u003E\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-01\u003C/td\u003E\u003Ctd\u003E\u0026quot;London\u0026quot;\u003C/td\u003E\u003Ctd\u003E10.5\u003C/td\u003E\u003Ctd\u003Etrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-01\u003C/td\u003E\u003Ctd\u003E\u0026quot;Manchester\u0026quot;\u003C/td\u003E\u003Ctd\u003E9\u003C/td\u003E\u003Ctd\u003Etrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-02\u003C/td\u003E\u003Ctd\u003E\u0026quot;London\u0026quot;\u003C/td\u003E\u003Ctd\u003E12.1\u003C/td\u003E\u003Ctd\u003Efalse\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003C/div\u003E"
        }
      ],
      "metadata": {
        "execution_count": 9
      }
    },
    {
      "id": "dba94e13-0d05-4abd-9ca9-09901f410b9c",
      "type": "code",
      "language": "csharp",
      "source": "var df_converted = df.Filter(Pl.Col(\u0022City\u0022) == \u0022London\u0022)\n                    .Select(Pl.Col(\u0022Date\u0022),(Pl.Col(\u0022Temperature\u0022) * 1.8 \u002B 32).Alias(\u0022Temp_F\u0022));\n\ndf_converted",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n\u003Cstyle\u003E\n.pl-dataframe { font-family: \u0027Consolas\u0027, \u0027Monaco\u0027, monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n\u003C/style\u003E\u003Cdiv class=\u0027pl-dim\u0027\u003EPolars DataFrame: \u003Cb\u003E(2 rows, 2 columns)\u003C/b\u003E\u003C/div\u003E\u003Cdiv style=\u0027overflow-x:auto\u0027\u003E\u003Ctable class=\u0027pl-dataframe\u0027\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EDate\u003Cspan class=\u0027pl-dtype\u0027\u003Edate32\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ETemp_F\u003Cspan class=\u0027pl-dtype\u0027\u003Edouble\u003C/span\u003E\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-01\u003C/td\u003E\u003Ctd\u003E50.9\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-02\u003C/td\u003E\u003Ctd\u003E53.78\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003C/div\u003E"
        }
      ],
      "metadata": {
        "execution_count": 10
      }
    },
    {
      "id": "bd117d2b-52be-4c1d-a606-e805d77574a7",
      "type": "code",
      "language": "csharp",
      "source": "var LondonDf = df.Filter(Pl.Col(\u0022City\u0022) == \u0022London\u0022);\n\nLondonDf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n\u003Cstyle\u003E\n.pl-dataframe { font-family: \u0027Consolas\u0027, \u0027Monaco\u0027, monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n\u003C/style\u003E\u003Cdiv class=\u0027pl-dim\u0027\u003EPolars DataFrame: \u003Cb\u003E(2 rows, 4 columns)\u003C/b\u003E\u003C/div\u003E\u003Cdiv style=\u0027overflow-x:auto\u0027\u003E\u003Ctable class=\u0027pl-dataframe\u0027\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EDate\u003Cspan class=\u0027pl-dtype\u0027\u003Edate32\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ECity\u003Cspan class=\u0027pl-dtype\u0027\u003Eutf8view\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ETemperature\u003Cspan class=\u0027pl-dtype\u0027\u003Edouble\u003C/span\u003E\u003C/th\u003E\u003Cth\u003ERain\u003Cspan class=\u0027pl-dtype\u0027\u003Ebool\u003C/span\u003E\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-01\u003C/td\u003E\u003Ctd\u003E\u0026quot;London\u0026quot;\u003C/td\u003E\u003Ctd\u003E10.5\u003C/td\u003E\u003Ctd\u003Etrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E2023-01-02\u003C/td\u003E\u003Ctd\u003E\u0026quot;London\u0026quot;\u003C/td\u003E\u003Ctd\u003E12.1\u003C/td\u003E\u003Ctd\u003Efalse\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003C/div\u003E"
        }
      ],
