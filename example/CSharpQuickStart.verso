      "id": "268a9594-eaa7-493e-ac66-e5bd99d2547a",
      "type": "code",
      "language": "csharp",
      "source": "#r \"nuget: Polars.NET, 1.0.1\"\n#r \"nuget: Polars.NET.Native.linux-x64, 1.0.1\"\n#r \"nuget: Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\"\n\nusing Microsoft.DotNet.Interactive.Formatting;\nusing Polars.CSharp;\nusing Pl = Polars.CSharp.Polars;\n\nFormatter.Register<DataFrame>((df,writer)=>\n{\n    writer.Write(df.ToHtml());\n}, \"text/html\");",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "System.InvalidOperationException: Package 'Polars.NET.Linq' v1.0.1 was not found on any configured source. Sources tried: https://api.nuget.org/v3/index.json",
