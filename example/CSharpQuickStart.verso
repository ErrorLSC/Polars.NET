    {
      "id": "dde9973a-007b-467c-803e-f6e6a174b175",
      "type": "code",
      "language": "csharp",
      "source": "var AggDf = df.\n        GroupBy(Pl.Col(\"City\"))\n        .Agg(Pl.Col(\"Temperature\").Mean().Alias(\"Avg_Temp\")\n            ,Pl.Col(\"Temperature\").Max().Alias(\"Max_Temp\")\n            ,Pl.Col(\"Rain\").Sum().Alias(\"Rainy_Days\")\n            ,Pl.Col(\"City\").Count().Alias(\"Total_Records\"));\n\nAggDf",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "(1,13): error CS0103: 当前上下文中不存在名称“df”\n(2,17): error CS0103: 当前上下文中不存在名称“Pl”\n(3,14): error CS0103: 当前上下文中不存在名称“Pl”\n(4,14): error CS0103: 当前上下文中不存在名称“Pl”\n(5,14): error CS0103: 当前上下文中不存在名称“Pl”\n(6,14): error CS0103: 当前上下文中不存在名称“Pl”",
