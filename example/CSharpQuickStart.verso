      }
    },
    {
      "id": "dba94e13-0d05-4abd-9ca9-09901f410b9c",
      "type": "code",
      "language": "csharp",
      "source": "var df_converted = df.Filter(Pl.Col(\"City\") == \"London\")\n                    .Select(Pl.Col(\"Date\"),(Pl.Col(\"Temperature\") * 1.8 + 32).Alias(\"Temp_F\"));\n\ndf_converted",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "(1,20): error CS0103: 当前上下文中不存在名称“df”\n(1,30): error CS0103: 当前上下文中不存在名称“Pl”\n(2,29): error CS0103: 当前上下文中不存在名称“Pl”\n(2,45): error CS0103: 当前上下文中不存在名称“Pl”",
