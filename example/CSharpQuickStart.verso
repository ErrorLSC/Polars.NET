    {
      "id": "429f3bc3-0753-4570-ad07-d50620cb6ec6",
      "type": "code",
      "language": "csharp",
      "source": "#r \u0022nuget: Polars.NET, 0.5.0\u0022\n#r \u0022nuget: Polars.NET.Core, 0.5.0\u0022\n#r \u0022nuget: Polars.NET.Native.linux-x64, 0.5.0\u0022\n#r \u0022nuget: Apache.Arrow, 23.0.0\u0022\n#r \u0022nuget: Apache.Arrow.Adbc\u0022\n#r \u0022nuget: Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\u0022\nusing Polars.CSharp;\nusing Pl = Polars.CSharp.Polars;\nusing Microsoft.DotNet.Interactive.Formatting;\nFormatter.Register\u003CDataFrame\u003E((df,writer)=\u003E\n{\n    writer.Write(df.ToHtml());\n}, \u0022text/html\u0022);",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\u003Cdiv\u003E\u003Cb\u003EInstalled Packages\u003C/b\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EPolars.NET, 0.5.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EPolars.NET.Core, 0.5.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EPolars.NET.Native.linux-x64, 0.5.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EApache.Arrow, 23.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EApache.Arrow.Adbc, 0.23.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cdetails\u003E\u003Csummary\u003ETransitive dependencies (11)\u003C/summary\u003E\u003Cul\u003E\u003Cli\u003E\u003Cspan\u003EApache.Arrow.Scalars, 23.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EFSharp.Core, 10.0.100\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.AspNetCore.Html.Abstractions, 2.3.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.Bcl.AsyncInterfaces, 10.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003EMicrosoft.CSharp, 4.7.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Diagnostics.DiagnosticSource, 9.0.6\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.IO.Pipelines, 10.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Memory, 4.6.3\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Numerics.Tensors, 10.0.5\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Text.Encodings.Web, 8.0.0\u003C/span\u003E\u003C/li\u003E\u003Cli\u003E\u003Cspan\u003ESystem.Text.Json, 10.0.0\u003C/span\u003E\u003C/li\u003E\u003C/ul\u003E\u003C/details\u003E\u003C/div\u003E"
