  "cells": [
    {
      "id": "268a9594-eaa7-493e-ac66-e5bd99d2547a",
      "type": "code",
      "language": "csharp",
      "source": "#r \"nuget: Polars.NET, 1.0.0\"\n#r \"nuget: Polars.NET.Native.linux-x64, 1.0.0\"\n#r \"nuget: Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\"\n\nusing Microsoft.DotNet.Interactive.Formatting;\nusing Polars.CSharp;\nusing Pl = Polars.CSharp.Polars;\n\nFormatter.Register<DataFrame>((df,writer)=>\n{\n    writer.Write(df.ToHtml());\n}, \"text/html\");",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "<div><b>已安装的包</b><ul><li><span>Polars.NET, 1.0.0</span></li><li><span>Polars.NET.Native.linux-x64, 1.0.0</span></li><li><span>Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1</span></li></ul><details><summary>Transitive dependencies (14)</summary><ul><li><span>Apache.Arrow, 23.0.0</span></li><li><span>Apache.Arrow.Adbc, 0.24.0</span></li><li><span>Apache.Arrow.Scalars, 23.0.0</span></li><li><span>FSharp.Core, 8.0.100</span></li><li><span>Microsoft.AspNetCore.Html.Abstractions, 2.3.0</span></li><li><span>Microsoft.Bcl.AsyncInterfaces, 10.0.0</span></li><li><span>Microsoft.CSharp, 4.7.0</span></li><li><span>Polars.NET.Core, 1.0.0</span></li><li><span>Polars.NET.Linq, 1.0.0</span></li><li><span>System.IO.Pipelines, 10.0.0</span></li><li><span>System.Memory, 4.6.3</span></li><li><span>System.Numerics.Tensors, 10.0.5</span></li><li><span>System.Text.Encodings.Web, 8.0.0</span></li><li><span>System.Text.Json, 10.0.0</span></li></ul></details></div>"
        }
      ]
    },
    {
      "id": "28e1b962-8d51-4d8c-bf6e-e37b9dc8f7ce",
      "type": "code",
      "language": "csharp",
      "source": "var df = DataFrame.FromColumns(new \n{\n    Date = new[] { \"2023-01-01\", \"2023-01-01\",\"2023-01-02\" }, // Index 0\n    City = new[] { \"London\", \"Manchester\",\"London\" },    // Index 1\n    Temperature = new[] { 10.5, 9.0,12.1 },   // Index 2\n    Rain = new[] {true,true,false} // Index 3\n})\n.WithColumns(Pl.Col(\"Date\").Str.ToDate(\"%Y-%m-%d\"));\n\ndf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n<style>\n.pl-dataframe { font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); color: inherit; }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; color: inherit; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n</style><div class='pl-dim'>Polars DataFrame: <b>(3 rows, 4 columns)</b></div><div style='overflow-x:auto'><table class='pl-dataframe'><thead><tr><th>Date<span class='pl-dtype'>date</span></th><th>City<span class='pl-dtype'>str</span></th><th>Temperature<span class='pl-dtype'>f64</span></th><th>Rain<span class='pl-dtype'>bool</span></th></tr></thead><tbody><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-01\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t10.5\n]</td><td>shape: (1,)\nSeries: &#39;Rain&#39; [bool]\n[\n\ttrue\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-01\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;Manchester&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t9.0\n]</td><td>shape: (1,)\nSeries: &#39;Rain&#39; [bool]\n[\n\ttrue\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-02\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t12.1\n]</td><td>shape: (1,)\nSeries: &#39;Rain&#39; [bool]\n[\n\tfalse\n]</td></tr></tbody></table></div>"
        }
      ],
      "metadata": {
        "execution_count": 9
      }
    },
    {
      "id": "dba94e13-0d05-4abd-9ca9-09901f410b9c",
      "type": "code",
      "language": "csharp",
      "source": "var df_converted = df.Filter(Pl.Col(\"City\") == \"London\")\n                    .Select(Pl.Col(\"Date\"),(Pl.Col(\"Temperature\") * 1.8 + 32).Alias(\"Temp_F\"));\n\ndf_converted",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n<style>\n.pl-dataframe { font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); color: inherit; }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; color: inherit; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n</style><div class='pl-dim'>Polars DataFrame: <b>(2 rows, 2 columns)</b></div><div style='overflow-x:auto'><table class='pl-dataframe'><thead><tr><th>Date<span class='pl-dtype'>date</span></th><th>Temp_F<span class='pl-dtype'>f64</span></th></tr></thead><tbody><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-01\n]</td><td>shape: (1,)\nSeries: &#39;Temp_F&#39; [f64]\n[\n\t50.9\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-02\n]</td><td>shape: (1,)\nSeries: &#39;Temp_F&#39; [f64]\n[\n\t53.78\n]</td></tr></tbody></table></div>"
        }
      ],
      "metadata": {
        "execution_count": 10
      }
    },
    {
      "id": "bd117d2b-52be-4c1d-a606-e805d77574a7",
      "type": "code",
      "language": "csharp",
      "source": "var LondonDf = df.Filter(Pl.Col(\"City\") == \"London\");\n\nLondonDf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n<style>\n.pl-dataframe { font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); color: inherit; }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; color: inherit; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n</style><div class='pl-dim'>Polars DataFrame: <b>(2 rows, 4 columns)</b></div><div style='overflow-x:auto'><table class='pl-dataframe'><thead><tr><th>Date<span class='pl-dtype'>date</span></th><th>City<span class='pl-dtype'>str</span></th><th>Temperature<span class='pl-dtype'>f64</span></th><th>Rain<span class='pl-dtype'>bool</span></th></tr></thead><tbody><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-01\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t10.5\n]</td><td>shape: (1,)\nSeries: &#39;Rain&#39; [bool]\n[\n\ttrue\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-02\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t12.1\n]</td><td>shape: (1,)\nSeries: &#39;Rain&#39; [bool]\n[\n\tfalse\n]</td></tr></tbody></table></div>"
        }
      ],
      "metadata": {
        "execution_count": 11
      }
    },
    {
      "id": "dde9973a-007b-467c-803e-f6e6a174b175",
      "type": "code",
      "language": "csharp",
      "source": "var AggDf = df.\n        GroupBy(Pl.Col(\"City\"))\n        .Agg(Pl.Col(\"Temperature\").Mean().Alias(\"Avg_Temp\")\n            ,Pl.Col(\"Temperature\").Max().Alias(\"Max_Temp\")\n            ,Pl.Col(\"Rain\").Sum().Alias(\"Rainy_Days\")\n            ,Pl.Col(\"City\").Count().Alias(\"Total_Records\"));\n\nAggDf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n<style>\n.pl-dataframe { font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); color: inherit; }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; color: inherit; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n</style><div class='pl-dim'>Polars DataFrame: <b>(2 rows, 5 columns)</b></div><div style='overflow-x:auto'><table class='pl-dataframe'><thead><tr><th>City<span class='pl-dtype'>str</span></th><th>Avg_Temp<span class='pl-dtype'>f64</span></th><th>Max_Temp<span class='pl-dtype'>f64</span></th><th>Rainy_Days<span class='pl-dtype'>u32</span></th><th>Total_Records<span class='pl-dtype'>u32</span></th></tr></thead><tbody><tr><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Avg_Temp&#39; [f64]\n[\n\t11.3\n]</td><td>shape: (1,)\nSeries: &#39;Max_Temp&#39; [f64]\n[\n\t12.1\n]</td><td>shape: (1,)\nSeries: &#39;Rainy_Days&#39; [u32]\n[\n\t1\n]</td><td>shape: (1,)\nSeries: &#39;Total_Records&#39; [u32]\n[\n\t2\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;Manchester&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Avg_Temp&#39; [f64]\n[\n\t9.0\n]</td><td>shape: (1,)\nSeries: &#39;Max_Temp&#39; [f64]\n[\n\t9.0\n]</td><td>shape: (1,)\nSeries: &#39;Rainy_Days&#39; [u32]\n[\n\t1\n]</td><td>shape: (1,)\nSeries: &#39;Total_Records&#39; [u32]\n[\n\t1\n]</td></tr></tbody></table></div>"
        }
      ],
      "metadata": {
        "execution_count": 12
      }
    },
    {
      "id": "d68687f0-c7e7-4bd8-9b96-9ba397d8d016",
      "type": "code",
      "language": "csharp",
      "source": "var WindowDf = df.Select(Pl.Col(\"Date\"),Pl.Col(\"City\"),Pl.Col(\"Temperature\")\n                        ,Pl.Col(\"Temperature\").Mean().Over(Pl.Col(\"Date\")).Alias(\"Daily_Avg\")\n                        ,(Pl.Col(\"Temperature\") - Pl.Col(\"Temperature\").Mean().Over(Pl.Col(\"Date\"))).Alias(\"Diff\")\n        ).Sort(\"Date\",false);\n\nWindowDf",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "\n<style>\n.pl-dataframe { font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); color: inherit; }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; color: inherit; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n</style><div class='pl-dim'>Polars DataFrame: <b>(3 rows, 5 columns)</b></div><div style='overflow-x:auto'><table class='pl-dataframe'><thead><tr><th>Date<span class='pl-dtype'>date</span></th><th>City<span class='pl-dtype'>str</span></th><th>Temperature<span class='pl-dtype'>f64</span></th><th>Daily_Avg<span class='pl-dtype'>f64</span></th><th>Diff<span class='pl-dtype'>f64</span></th></tr></thead><tbody><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-01\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t10.5\n]</td><td>shape: (1,)\nSeries: &#39;Daily_Avg&#39; [f64]\n[\n\t9.75\n]</td><td>shape: (1,)\nSeries: &#39;Diff&#39; [f64]\n[\n\t0.75\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-01\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;Manchester&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t9.0\n]</td><td>shape: (1,)\nSeries: &#39;Daily_Avg&#39; [f64]\n[\n\t9.75\n]</td><td>shape: (1,)\nSeries: &#39;Diff&#39; [f64]\n[\n\t-0.75\n]</td></tr><tr><td>shape: (1,)\nSeries: &#39;Date&#39; [date]\n[\n\t2023-01-02\n]</td><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Temperature&#39; [f64]\n[\n\t12.1\n]</td><td>shape: (1,)\nSeries: &#39;Daily_Avg&#39; [f64]\n[\n\t12.1\n]</td><td>shape: (1,)\nSeries: &#39;Diff&#39; [f64]\n[\n\t0.0\n]</td></tr></tbody></table></div>"
        }
      ],
      "metadata": {
        "execution_count": 13
      }
    },
    {
      "id": "d015c7f8-fa8b-4152-98f3-256c1a267aac",
      "type": "code",
      "language": "csharp",
      "source": "var lf = \n    df.Lazy()\n        .Filter(Pl.Col(\"Temperature\") > 10.0)\n        .GroupBy(\"City\")\n        .Agg(Pl.Col(\"Temperature\").Mean().Alias(\"Lazy_Avg_Temp\"));\n\nSystem.Console.WriteLine(lf.Explain(true));\n\nvar finalDf = lf.Collect();\n\nfinalDf",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "AGGREGATE[maintain_order: true]\n  [col(\"Temperature\").mean().alias(\"Lazy_Avg_Temp\")] BY [col(\"City\")]\n  FROM\n  FILTER col(\"Temperature\") > 10.0\n  FROM\n    DF [\"Date\", \"City\", \"Temperature\", \"Rain\"]; PROJECT[\"City\", \"Temperature\"] 2/4 COLUMNS\n"
        },
        {
          "mimeType": "text/html",
          "content": "\n<style>\n.pl-dataframe { font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; border-collapse: collapse; border: 1px solid rgba(128, 128, 128, 0.2); }\n.pl-dataframe th { font-weight: bold; text-align: left; padding: 6px 12px; border-bottom: 2px solid rgba(128, 128, 128, 0.3); color: inherit; }\n.pl-dataframe td { padding: 6px 12px; border-bottom: 1px solid rgba(128, 128, 128, 0.2); white-space: pre; color: inherit; }\n.pl-dataframe tr:nth-child(even) { background-color: rgba(128, 128, 128, 0.05); }\n.pl-dataframe tr:hover { background-color: rgba(128, 128, 128, 0.1); }\n.pl-dtype { font-size: 10px; color: rgba(128, 128, 128, 0.8); display: block; margin-top: 2px; font-weight: normal; }\n.pl-null { color: rgba(128, 128, 128, 0.5); font-style: italic; }\n.pl-dim { font-family: sans-serif; font-size: 12px; opacity: 0.8; margin-bottom: 8px; }\n</style><div class='pl-dim'>Polars DataFrame: <b>(1 rows, 2 columns)</b></div><div style='overflow-x:auto'><table class='pl-dataframe'><thead><tr><th>City<span class='pl-dtype'>str</span></th><th>Lazy_Avg_Temp<span class='pl-dtype'>f64</span></th></tr></thead><tbody><tr><td>shape: (1,)\nSeries: &#39;City&#39; [str]\n[\n\t&quot;London&quot;\n]</td><td>shape: (1,)\nSeries: &#39;Lazy_Avg_Temp&#39; [f64]\n[\n\t11.3\n]</td></tr></tbody></table></div>"
        }
      ],
      "metadata": {
        "execution_count": 14
      }
    }
