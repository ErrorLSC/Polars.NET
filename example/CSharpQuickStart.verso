      "id": "268a9594-eaa7-493e-ac66-e5bd99d2547a",
      "type": "code",
      "language": "csharp",
      "source": "#r \"nuget: Polars.NET, 1.0.0\"\n#r \"nuget: Polars.NET.Native.linux-x64, 1.0.0\"\n#r \"nuget: Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\"\n\nusing Microsoft.DotNet.Interactive.Formatting;\nusing Polars.CSharp;\nusing Pl = Polars.CSharp.Polars;\n\nFormatter.Register<DataFrame>((df,writer)=>\n{\n    writer.Write(df.ToHtml());\n}, \"text/html\");",
      "outputs": [
        {
          "mimeType": "text/html",
          "content": "<div><b>已安装的包</b><ul><li><span>Polars.NET.Native.linux-x64, 1.0.0</span></li><li><span>Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1</span></li></ul><details><summary>Transitive dependencies (7)</summary><ul><li><span>Microsoft.AspNetCore.Html.Abstractions, 2.3.0</span></li><li><span>Microsoft.Bcl.AsyncInterfaces, 10.0.0</span></li><li><span>Microsoft.CSharp, 4.7.0</span></li><li><span>System.IO.Pipelines, 10.0.0</span></li><li><span>System.Memory, 4.6.3</span></li><li><span>System.Text.Encodings.Web, 8.0.0</span></li><li><span>System.Text.Json, 10.0.0</span></li></ul></details></div>"
        },
