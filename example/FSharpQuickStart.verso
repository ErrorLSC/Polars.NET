    {
      "id": "ec903e72-d89c-4840-a174-2c1f762ee829",
      "type": "code",
      "language": "fsharp",
      "source": "let df_converted =\n    df \n    |\u003E pl.filter (pl.col \u0022City\u0022 .== pl.lit \u0022London\u0022)\n    |\u003E pl.select [\n        pl.col(\u0022Date\u0022)\n        (pl.col(\u0022Temperature\u0022) * pl.lit 1.8 \u002B pl.lit 32.0) |\u003E pl.alias \u0022Temp_F\u0022\n    ]\n\ndf_converted",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "input.fsx (2,5)-(2,7) typecheck error The value or constructor \u0027df\u0027 is not defined.",
          "isError": true,
          "errorName": "CompilationError"
        }
