      "type": "code",
      "language": "fsharp",
      "source": "let lf = \n    df \n    |> pl.asLazy\n    |> LazyFrame.filter (pl.col \"Temperature\" .> pl.lit 10.0)\n    |> LazyFrame.groupBy [pl.col \"City\"] \n    |> LazyFrame.agg [(pl.col \"Temperature\").Mean() |> pl.alias \"Lazy_Avg_Temp\"]   \n    \nprintfn \"%s\" (lf.Explain(optimized=true))\n\nlet finalDf = lf.Collect()\n\nfinalDf",
      "outputs": [
