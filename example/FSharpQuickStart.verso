      "id": "ec903e72-d89c-4840-a174-2c1f762ee829",
      "type": "code",
      "language": "fsharp",
      "source": "let df_converted =\n    df \n    |> DataFrame.filter (pl.col \"City\" .== pl.lit \"London\")\n    |> DataFrame.select [\n        pl.col(\"Date\")\n        (pl.col(\"Temperature\") * pl.lit 1.8 + pl.lit 32.0) |> pl.alias \"Temp_F\"\n    ]\n\ndf_converted",
