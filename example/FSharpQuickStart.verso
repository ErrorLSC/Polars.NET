      "type": "code",
      "language": "fsharp",
      "source": "#r \u0022nuget: Polars.FSharp, 0.5.0\u0022\n#r \u0022nuget: Polars.NET.Core, 0.5.0\u0022\n#r \u0022nuget: Polars.NET.Native.linux-x64, 0.5.0\u0022\n#r \u0022nuget: Apache.Arrow, 23.0.0\u0022\n#r \u0022nuget: Apache.Arrow.Adbc\u0022\n#r \u0022nuget: Microsoft.DotNet.Interactive.Formatting, 1.0.0-beta.26120.1\u0022\nopen System\nopen Microsoft.DotNet.Interactive.Formatting\nopen Polars.FSharp\nlet display (x: obj) = x\nDisplay.init()",
