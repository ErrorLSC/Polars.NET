<Project>
  <PropertyGroup>
    <Version>1.2.0</Version>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <Authors>ErrorLSC</Authors>
    <RepositoryUrl>https://github.com/ErrorLSC/Polars.NET</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- C# 14 for every C# project (net8 targets included: the features used are compiler-only). Pinned, not latest,
       so a newer SDK does not change the language under us; F# has its own versions, hence the condition. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <ParallelCompilation>true</ParallelCompilation>
    <OtherFlags>$(OtherFlags) --parallelcompilation+</OtherFlags>
    <NoWarn>$(NoWarn);FS0075;75</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <ParallelCompilation Include="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)THIRD_PARTY_LICENSES.html" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>