<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <DisableImplicitFSharpCoreReference>false</DisableImplicitFSharpCoreReference>

    <PackageId>Polars.FSharp</PackageId>
    <Authors>ErrorLSC</Authors>
    <Description>Idiomatic F# API for Polars DataFrame library with strict type safety and pipeline support.</Description>
    <PackageTags>polars;dataframe;fsharp;functional;data-science</PackageTags>
    <RepositoryUrl>https://github.com/ErrorLSC/Polars.NET</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Enums.fs" />
    <Compile Include="DataType.fs" />
    <Compile Include="CloudOptions.fs" />
    <Compile Include="UdfUtils.fs" />
    <Compile Include="Exprs.fs" />
    <Compile Include="Expr/StringOps.fs" />
    <Compile Include="Expr/ListOps.fs" />
    <Compile Include="Expr/ArrayOps.fs" />
    <Compile Include="Expr/NameOps.fs" />
    <Compile Include="Expr/StructOps.fs" />
    <Compile Include="Expr/MetaOps.fs" />
    <Compile Include="Expr/DtOps.fs" />
    <Compile Include="Expr/ExprNamespaces.fs" />
    <Compile Include="Types.fs" />  
    <Compile Include="UnionTypes.fs" />
    <Compile Include="Series/Series.StringOps.fs" />
    <Compile Include="Series/Series.ListOps.fs" />
    <Compile Include="Series/Series.ArrayOps.fs" />
    <Compile Include="Series/Series.StructOps.fs" />
    <Compile Include="Series/Series.Operations.fs" />
    <Compile Include="Expr/RollingOps.fs" />
    <Compile Include="Series/Series.RollingOps.fs" />
    <Compile Include="Operations/ValueAccessors.fs" />
    <Compile Include="Series/Series.DtOps.fs" />
    <Compile Include="Series/Series.Namespaces.fs" />
    <Compile Include="IO/CSV/Read.fs" />
    <Compile Include="IO/CSV/Write.fs" />
    <Compile Include="IO/JSON/Read.fs" />
    <Compile Include="IO/JSON/Write.fs" />
    <Compile Include="IO/Parquet/Read.fs" />
    <Compile Include="IO/Parquet/Write.fs" />
    <Compile Include="IO/IPC/Read.fs" />
    <Compile Include="IO/IPC/Write.fs" />
    <Compile Include="IO/ADO.NET/Read.fs" />
    <Compile Include="IO/ADO.NET/Write.fs" />
    <Compile Include="IO/ADBC.fs" />
    <Compile Include="IO/Avro.fs" />
    <Compile Include="IO/Excel.fs" />
    <Compile Include="Operations/Cast.fs" />
    <Compile Include="Operations/Manipulations.fs" />
    <Compile Include="Operations/Sort.fs" />
    <Compile Include="Operations/Join.fs" />
    <Compile Include="Operations/GroupBy.fs" />
    <Compile Include="Operations/Pivot.fs" />
    <Compile Include="Operations/TensorInterops.fs" />
    <Compile Include="DataFrame/DataFrame.Factory.fs" />
    <Compile Include="Ops.fs" />
    <Compile Include="Display.fs" />
    <Compile Include="Polars.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="IO/Delta/Delta.fs" />
    <Compile Include="IO/Delta/Read.fs" />
    <Compile Include="IO/Delta/Write.fs" />
    <Compile Include="IO/Catalog.fs" />
    <Compile Include="Config.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Polars.NET.Core/Polars.NET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polars.NET.ML" />
    <InternalsVisibleTo Include="Polars.NET.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="Apache.Arrow.Adbc" Version="0.23.0" />
    <PackageReference Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-beta.*" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.5" />
  </ItemGroup>

</Project>
