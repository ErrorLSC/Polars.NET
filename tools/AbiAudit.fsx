// Native ABI audit: pairs every C# P/Invoke declaration in Polars.NET.Core with the Rust
// `extern "C"` export of the same name in native_shim and compares parameter counts.
// Exports generated by `macro_rules!` are resolved through the macro's own fn template.
//
// A count mismatch means the callee reads arguments that were never passed (undefined behavior),
// so this catches missing or extra parameters. It does not check parameter types or order.
//
// Usage: dotnet fsi tools/AbiAudit.fsx [rustSrcDir] [csharpDir]
// Exit code: 0 = clean, 1 = mismatches or C# imports without a Rust export.

open System
open System.IO
open System.Text.RegularExpressions

let repoRoot = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, ".."))

let args = fsi.CommandLineArgs |> Array.skip 1
let rustDir = if args.Length > 0 then args.[0] else Path.Combine(repoRoot, "native_shim", "src")
let csDir = if args.Length > 1 then args.[1] else Path.Combine(repoRoot, "kernel", "Polars.NET.Core")

/// C# imports that intentionally have no export in the pinned native build.
let knownUnexported =
    set [
        // Present in upstream Polars main but not exposed in the pinned release; kept as a forward hook.
        "pl_config_get_ooc_spill_policy"
    ]

let stripComments (text: string) =
    let noBlock = Regex.Replace(text, @"/\*.*?\*/", "", RegexOptions.Singleline)
    Regex.Replace(noBlock, @"//[^\n]*", "")

/// Returns the text between position `start` (just after an opening delimiter) and its matching
/// closing delimiter, plus the index just past that closing delimiter.
let balanced (text: string) (start: int) (openCh: char) (closeCh: char) =
    let mutable depth = 1
    let mutable j = start
    while depth > 0 && j < text.Length do
        let c = text.[j]
        if c = openCh then depth <- depth + 1
        elif c = closeCh then depth <- depth - 1
        j <- j + 1
    text.Substring(start, j - 1 - start), j

/// Splits a parameter list on top-level commas.
let splitParams (paramText: string) =
    // `->` inside Rust fn-pointer types would otherwise unbalance the `<` / `>` depth.
    let s = paramText.Replace("->", "~")
    let parts = ResizeArray<string>()
    let cur = Text.StringBuilder()
    let mutable depth = 0
    for c in s do
        if "<([".Contains c then depth <- depth + 1
        if ">)]".Contains c then depth <- depth - 1
        if c = ',' && depth = 0 then
            parts.Add(cur.ToString())
            cur.Clear() |> ignore
        else
            cur.Append c |> ignore
    parts.Add(cur.ToString())
    parts |> Seq.map (fun p -> p.Trim()) |> Seq.filter (fun p -> p <> "") |> Seq.length

let filesUnder (dir: string) (pattern: string) =
    Directory.EnumerateFiles(dir, pattern, SearchOption.AllDirectories)
    |> Seq.filter (fun f ->
        let n = f.Replace('\\', '/')
        not (n.Contains "/obj/" || n.Contains "/bin/" || n.Contains "/target/"))
    |> Seq.toList

// ---------------------------------------------------------------- Rust exports
let rustTexts = filesUnder rustDir "*.rs" |> List.map (fun f -> f, stripComments (File.ReadAllText f))

let externFn = Regex(@"extern\s+""C""\s+fn\s+(\w+)\s*(?:<[^>]*>)?\s*\(")
let externTemplateFn = Regex(@"extern\s+""C""\s+fn\s+\$\w+\s*\(")

let rustExports =
    [ for f, t in rustTexts do
          for m in externFn.Matches t do
              let paramText, _ = balanced t (m.Index + m.Length) '(' ')'
              yield m.Groups.[1].Value, splitParams paramText ]
    |> Map.ofList

/// macro name -> parameter counts of every extern fn template in its body
let macroTemplates =
    [ for _, t in rustTexts do
          for m in Regex.Matches(t, @"macro_rules!\s*(\w+)\s*\{") do
              let body, _ = balanced t (m.Index + m.Length) '{' '}'
              let counts =
                  [ for fm in externTemplateFn.Matches body do
                        let paramText, _ = balanced body (fm.Index + fm.Length) '(' ')'
                        yield splitParams paramText ]
              if not counts.IsEmpty then yield m.Groups.[1].Value, counts ]
    |> Map.ofList

/// exported name -> (allowed parameter counts, macro name)
let macroExports =
    [ for _, t in rustTexts do
          for KeyValue(macroName, counts) in macroTemplates do
              for m in Regex.Matches(t, @"\b" + macroName + @"!\s*([\(\{\[])") do
                  let openCh = m.Groups.[1].Value.[0]
                  let closeCh = match openCh with '(' -> ')' | '{' -> '}' | _ -> ']'
                  let argText, _ = balanced t (m.Index + m.Length) openCh closeCh
                  for fn in Regex.Matches(argText, @"\b(pl_\w+)\b") do
                      yield fn.Groups.[1].Value, (counts, macroName) ]
    |> Map.ofList

// ---------------------------------------------------------------- C# imports
let importAttr = Regex(@"\[\s*(?:LibraryImport|DllImport)\s*\(")
let entryPoint = Regex(@"EntryPoint\s*=\s*""(\w+)""")
let methodName = Regex(@"(\w+)\s*$")

type CsImport = { Name: string; ParamCount: int; File: string }

let csImports =
    [ for f in filesUnder csDir "*.cs" do
          let t = stripComments (File.ReadAllText f)
          for m in importAttr.Matches t do
              let attrArgs, afterArgs = balanced t (m.Index + m.Length) '(' ')'
              // Close the import attribute, then skip any further attribute blocks
              // such as [return: MarshalAs(...)] or [UnmanagedCallConv(...)].
              let mutable i = t.IndexOf(']', afterArgs) + 1
              let mutable skipping = true
              while skipping do
                  while i < t.Length && Char.IsWhiteSpace t.[i] do i <- i + 1
                  if i < t.Length && t.[i] = '[' then
                      let _, next = balanced t (i + 1) '[' ']'
                      i <- next
                  else
                      skipping <- false
              let parenIdx = t.IndexOf('(', i)
              let signature = t.Substring(i, parenIdx - i)
              let paramText, _ = balanced t (parenIdx + 1) '(' ')'
              let declared = methodName.Match(signature).Groups.[1].Value
              let ep = entryPoint.Match attrArgs
              let name = if ep.Success then ep.Groups.[1].Value else declared
              let withoutAttrs = Regex.Replace(paramText, @"\[[^\]]*\]", "")
              yield { Name = name; ParamCount = splitParams withoutAttrs; File = Path.GetFileName f } ]

// ---------------------------------------------------------------- Compare
let mismatches = ResizeArray<string>()
let unresolved = ResizeArray<string>()

for imp in csImports do
    match Map.tryFind imp.Name rustExports with
    | Some rustCount ->
        if rustCount <> imp.ParamCount then
            mismatches.Add(sprintf "%s: C# %d vs Rust %d (%s)" imp.Name imp.ParamCount rustCount imp.File)
    | None ->
        match Map.tryFind imp.Name macroExports with
        | Some(counts, macroName) ->
            if not (List.contains imp.ParamCount counts) then
                mismatches.Add(sprintf "%s: C# %d vs %s! %A (%s)" imp.Name imp.ParamCount macroName counts imp.File)
        | None ->
            if not (knownUnexported.Contains imp.Name) then
                unresolved.Add(sprintf "%s (%s)" imp.Name imp.File)

printfn "Rust exports: %d direct, %d macro-generated" rustExports.Count macroExports.Count
printfn "C# imports:   %d" csImports.Length
printfn "Known unexported (allowed): %s" (String.Join(", ", knownUnexported))

if unresolved.Count > 0 then
    printfn "\nC# imports without a Rust export: %d" unresolved.Count
    for u in Seq.sort unresolved do printfn "  %s" u

if mismatches.Count > 0 then
    printfn "\nParameter count mismatches: %d" mismatches.Count
    for m in Seq.sort mismatches do printfn "  %s" m

if mismatches.Count = 0 && unresolved.Count = 0 then
    printfn "\nABI audit passed."
    exit 0
else
    exit 1
