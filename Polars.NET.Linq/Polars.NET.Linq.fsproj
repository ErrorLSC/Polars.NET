<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Polars.NET.Linq</PackageId> 
    <Authors>ErrorLSC</Authors>
    <Description>LINQ Translation Engine for Polars.NET and Polars.FSharp. Write strong-typed C#/F# queries and execute them at native speed</Description>
    <PackageTags>polars;dataframe;data-analysis;linq;ast</PackageTags>
    <RepositoryUrl>https://github.com/ErrorLSC/Polars.NET</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PartialEvaluator.fs" />
    <Compile Include="IR/Vocabulary.fs" />
    <Compile Include="OpsSpecs.fs" />
    <Compile Include="IR/LogicalTypes.fs" />
    <Compile Include="IR/JsonDataType.fs" />
    <Compile Include="IR/LogicalIR.fs" />
    <Compile Include="IR/ScalarExpr.fs" />
    <Compile Include="IR/BackendContracts.fs" />
    <Compile Include="IR/LogicalPlan.fs" />
    <Compile Include="IR/SourceRegistry.fs" />
    <Compile Include="IR/SchemaInference.fs" />
    <Compile Include="QueryCache/QueryCacheKey.fs" />
    <Compile Include="ExpressionPatterns.fs" />
    <Compile Include="LinqReflectionCache.fs" />
    <Compile Include="ScopeNavigation.fs" />
    <Compile Include="Translators/TranslationContext.fs" />
    <Compile Include="Translators/NullSemantics.fs" />
    <Compile Include="Translators/ColumnResolver.fs" />
    <Compile Include="Translators/MemberAccessTranslator.fs" />
    <Compile Include="Translators/StringTemporalTranslator.fs" />
    <Compile Include="Translators/NumericTranslator.fs" />
    <Compile Include="Translators/RegexTranslator.fs" />
    <Compile Include="Translators/WindowAndMethodTranslator.fs" />
    <Compile Include="Translators/ListTranslator.fs" />
    <Compile Include="Translators/JsonTranslator.fs" />
    <Compile Include="Translators/OperatorAndUdfTranslator.fs" />
    <Compile Include="ExprTranslator.fs" />
    <Compile Include="AggTranslator.fs" />
    <Compile Include="FSharpAstRewriter.fs" />
    <Compile Include="SourceResolver.fs" />
    <Compile Include="SubqueryDecorrelator.fs" />
    <Compile Include="QueryCache/QueryPlanCache.fs" />
    <Compile Include="Pipeline/PipelineTypes.fs" />
    <Compile Include="Pipeline/PipelineStageParser.fs" />
    <Compile Include="IR/EntityPacking.fs" />
    <Compile Include="IR/Building/TransparentScopes.fs" />
    <Compile Include="IR/Building/ProjectionExtraction.fs" />
    <Compile Include="IR/Building/GroupByPlanning.fs" />
    <Compile Include="IR/Building/GroupingSetsPlanning.fs" />
    <Compile Include="IR/Building/GroupJoinAndZipPlanning.fs" />
    <Compile Include="IR/Building/StageContext.fs" />
    <Compile Include="IR/Building/RowStages.fs" />
    <Compile Include="IR/Building/GroupStages.fs" />
    <Compile Include="IR/Building/JoinStages.fs" />
    <Compile Include="IR/Building/SetStages.fs" />
    <Compile Include="IR/TreeBuilder.fs" />
    <Compile Include="IR/Passes/EnumResolution.fs" />
    <Compile Include="IR/Passes/SortSliceFusion.fs" />
    <Compile Include="IR/Passes/FilterNullSimplification.fs" />
    <Compile Include="IR/Passes/PredicatePushdown.fs" />
    <Compile Include="IR/Passes/ProjectionPruning.fs" />
    <Compile Include="IR/Passes/GroupOrderRelaxation.fs" />
    <Compile Include="IR/Passes/LogicalOptimizer.fs" />
    <Compile Include="ScalarPlanner.fs" />
    <!-- Polars execution backend: must stay after the frontend and IR so the compiler enforces the dependency direction -->
    <Compile Include="Backend/Polars/MaterializerInvokers.fs" />
    <Compile Include="Backend/Polars/PolarsPlanSource.fs" />
    <Compile Include="Backend/Polars/NativeOpsApplier.fs" />
    <Compile Include="Backend/Polars/PolarsVocabulary.fs" />
    <Compile Include="Backend/Polars/PolarsScalarLowerer.fs" />
    <Compile Include="Backend/Polars/PolarsPhysicalLowerer.fs" />
    <Compile Include="Backend/Polars/PolarsObjectConverter.fs" />
    <Compile Include="Backend/Polars/PolarsQueryBackend.fs" />
    <Compile Include="Backend/Polars/PolarsScalarRunner.fs" />
    <Compile Include="Backend/Polars/PolarsExprCompiler.fs" />
    <Compile Include="Execution/PipelineCompilation.fs" />
    <Compile Include="Execution/RowMaterialization.fs" />
    <Compile Include="Execution/InMemoryExecution.fs" />
    <Compile Include="Execution/PlanInspectionReport.fs" />
    <Compile Include="Execution/AsyncQueryEnumerator.fs" />
    <Compile Include="Execution/ElementUpcast.fs" />
    <Compile Include="PolarsQueryable.fs" />
  </ItemGroup>

  <ItemGroup>
      <ProjectReference Include="..\Polars.NET.Core\Polars.NET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polars.CSharp" />
    <InternalsVisibleTo Include="Polars.CSharp.Tests" />
    <InternalsVisibleTo Include="Polars.FSharp" />
    <InternalsVisibleTo Include="Polars.FSharp.Tests" />
    <InternalsVisibleTo Include="Polars.Config.Tests" />
    <InternalsVisibleTo Include="Polars.NET.Linq.Conformance.Tests" />
  </ItemGroup>

</Project>
