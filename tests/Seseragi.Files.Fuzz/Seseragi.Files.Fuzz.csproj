<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mutation fuzzer for the managed Parquet reader and its unsafe kernels (not a test project: run by hand). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\Seseragi\Files\Seseragi.Files.csproj" />
  </ItemGroup>

  <!-- The writer cases build batches and compare values as the writer tests do. -->
  <ItemGroup>
    <Compile Include="..\Seseragi.Files.Tests\TestBatches.cs" Link="Shared\TestBatches.cs" />
    <Compile Include="..\Seseragi.Files.Tests\Parquet\ParquetWriteData.cs" Link="Shared\ParquetWriteData.cs" />
    <Compile Include="..\Seseragi.Files.Tests\Parquet\ParquetNestedData.cs" Link="Shared\ParquetNestedData.cs" />
    <Compile Include="..\Seseragi.Files.Tests\Parquet\CanonicalRender.cs" Link="Shared\CanonicalRender.cs" />
  </ItemGroup>

</Project>
