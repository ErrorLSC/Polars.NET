<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
    <DisableImplicitFSharpCoreReference>false</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <PropertyGroup>
    <RustProjectDir>$(RepoRoot)native_shim</RustProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestUtils.fs" />
    <Compile Include="BasicTests.fs" />
    <Compile Include="ExprTests.fs" />
    <Compile Include="ComplexTests.fs" />
    <Compile Include="SafetyTests.fs" />
    <Compile Include="UDFTests.fs" />
    <Compile Include="SeriesTests.fs" />
    <Compile Include="ExtensionsTests.fs" />
    <Compile Include="SelectorTests.fs" />
    <Compile Include="IOTests.fs" />
    <Compile Include="ExcelTests.fs" />
    <Compile Include="DeltaTests.fs" />
    <Compile Include="SeseragiDeltaDifferentialTests.fs" />
    <Compile Include="QueryTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="DataFrameTests.fs" />
    <Compile Include="AsyncTests.fs" />
    <Compile Include="StreamWriteTests.fs" />
    <Compile Include="StreamWriteTests.ParquetCsv.fs" />
    <Compile Include="StreamWriteTests.JsonAvro.fs" />
    <Compile Include="TpchLinqTests.fs" />
    <Compile Include="LogicalPlanOptimizerTests.fs" />
    <Compile Include="GroupOrderRelaxationTests.fs" />
    <Compile Include="CommonSubplanSharingTests.fs" />
    <Compile Include="PredicatePushdownTests.fs" />
    <Compile Include="JoinReorderingTests.fs" />
    <Compile Include="SemiJoinReductionTests.fs" />
    <Compile Include="AntiJoinRecognitionTests.fs" />
    <Compile Include="OuterJoinSimplificationTests.fs" />
    <Compile Include="ColumnStatisticsTests.fs" />
    <Compile Include="CardinalityFeedbackTests.fs" />
    <Compile Include="EagerAggregationTests.fs" />
    <Compile Include="GroupingSetsCascadeTests.fs" />
    <Compile Include="UnionAggregateFlatteningTests.fs" />
    <Compile Include="QueryNestedEntityTests.fs" />
    <Compile Include="EnumColumnTests.fs" />
    <Compile Include="SubqueryGraftingTests.fs" />
    <Compile Include="QueryOptionSemanticsTests.fs" />
    <Compile Include="DisplayTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MiniExcel" Version="1.42.0" />
    <!-- Test-only: verifies Display.init registers with a real .NET Interactive formatter (late-bound in the library). -->
    <PackageReference Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-beta.26120.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Polars.FSharp\Polars.FSharp.fsproj" />
    <ProjectReference Include="..\..\kernel\Seseragi\Delta\Seseragi.Delta.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RustLibPath>$(RustProjectDir)\target\debug\libnative_shim.so</RustLibPath>
    <RustLibName>libnative_shim.so</RustLibName>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <RustLibPath>$(RustProjectDir)\target\debug\native_shim.dll</RustLibPath>
    <RustLibName>native_shim.dll</RustLibName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(RustLibPath)">
      <Link>$(RustLibName)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
