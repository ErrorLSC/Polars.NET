<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Kaminari.Seseragi.Lakehouse</PackageId>
    <AssemblyName>Kaminari.Seseragi.Lakehouse</AssemblyName>
    <RootNamespace>Kaminari.Seseragi.Lakehouse</RootNamespace>
    <Authors>ErrorLSC</Authors>
    <Description>Managed lakehouse table format kernels (Delta Lake, Iceberg) and their catalog clients for the Kaminari projects.</Description>
    <RepositoryUrl>https://github.com/ErrorLSC/Polars.NET</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seseragi.Lakehouse.Tests" />
    <InternalsVisibleTo Include="Polars.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sazanami\Sazanami.csproj" />
    <ProjectReference Include="..\Files\Seseragi.Files.csproj" />
    <ProjectReference Include="..\..\Samidare\Samidare.fsproj" />
  </ItemGroup>

</Project>
