<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Kaminari.Seseragi.Files</PackageId>
    <AssemblyName>Kaminari.Seseragi.Files</AssemblyName>
    <RootNamespace>Kaminari.Seseragi.Files</RootNamespace>
    <Authors>ErrorLSC</Authors>
    <Description>Managed file format readers and writers (Avro, Excel) streaming Apache Arrow record batches, for the Kaminari projects.</Description>
    <RepositoryUrl>https://github.com/ErrorLSC/Polars.NET</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seseragi.Files.Tests" />
    <InternalsVisibleTo Include="Seseragi.Files.Fuzz" />
    <InternalsVisibleTo Include="Kaminari.Seseragi.Lakehouse" />
    <InternalsVisibleTo Include="Seseragi.Lakehouse.Tests" />
    <InternalsVisibleTo Include="Polars.Config.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sazanami\Sazanami.csproj" />
    <ProjectReference Include="..\..\Samidare\Samidare.fsproj" />
  </ItemGroup>

</Project>
